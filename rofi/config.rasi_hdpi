configuration {
    display-drun:                   "Apps";
    display-window:                 "Window";
    show-icons:true;
}
 
 * {
    lines: 15;
    columns: 1;
    background-color: #282a36d9;
    border-color: #bd93f9;
    text-color: #f8f8f2;
    font: "SF Pro Text 20";

    background: #282a36;
    foreground: #f8f8f2;
    lightbg: #44475a;
    lightfg: #bd93f9;
    blue: #8be9fd;
    red: #ff5555;
}
 
#window {
    background-color: #282a36;
    border: 0;
    border-radius: 4px;
    padding: 40;
    width: 30%;
    height: 50%;
}
 
#mainbox {
    background-color: #00000000;
    children: [inputbar, listview];
    spacing: 10px;
    /*margin: 20%;*/
    padding: 30px 0;
    border: 1px;
    border-color: #44475a;
}
 
 
#listview {
    background-color: #00000000;
    fixed-height: 0;
    border: 0px;
    spacing: 5px;
    scrollbar: false;
    padding: 10px 10px 0px;
}
 
#element {
    background-color: #00000000;
    border: 0;
    border-radius: 15px;
    padding: 3 0  3 4 ;
}
 
#element selected {
    background-color: #bd93f9;
    text-color: #282a36;
}

#element normal.normal {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element normal.active {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element normal.urgent {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element alternate.normal {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element alternate.active {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element alternate.urgent {
    background-color: transparent;
    text-color: #f8f8f2;
}

#element selected.normal {
    background-color: #bd93f9;
    text-color: #282a36;
}

#element selected.active {
    background-color: #bd93f9;
    text-color: #282a36;
}

#element selected.urgent {
    background-color: #ff5555;
    text-color: #282a36;
}
 
 
#inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
    background-color: #00000000;
}
 
#case-indicator {
    background-color: #00000000;
    spacing:    0;
}
#entry {
    background-color: #00000000;
    spacing:    0;
    placeholder-color: #6272a4;
}
#prompt {
    background-color: #00000000;
    spacing:    0;
    text-color: #bd93f9;
}
 
#textbox-prompt-colon {
    background-color: #00000000;
    expand:     false;
    str:        ":";
    text-color: #bd93f9;
    margin:     0px 0.3em 0em 0em ;
}

