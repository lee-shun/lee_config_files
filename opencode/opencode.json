{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llamacpp-server (local)",
      "options": {
        "baseURL": "http://192.168.1.105:8080/v1"
      },
      "models": {
        "llamacpp_local": {
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "llamacpp(local)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {},
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
