{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/llamacpp_local",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llamacpp-server (local)",
      "options": {
        "baseURL": "http://192.168.1.105:8080/v1"
      },
      "models": {
        "llamacpp_local": {
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Qwopus3.5-27B (Local)",
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
